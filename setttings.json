{
  "imports": "./settings.js",
  "sections": [
    {
      "id": "scraper",
      "label": "Scraper Connection",
      "icon": "spider",
      "accent": "mauve",
      "entries": [
        {
          "id": "proxyConfig",
          "label": "CORS Proxy",
          "description": "The local address of your running proxy.js node server.",
          "icon": "network-wired",
          "elements": [
            {
              "type": "input",
              "id": "proxyUrlInput",
              "inputType": "url",
              "variable": "proxyUrl",
              "default": "http://localhost:4269"
            },
            {
              "type": "button",
              "id": "testProxyBtn",
              "label": "Test Proxy",
              "accent": "mauve",
              "execute": "testProxyConnection(proxyUrl)"
            }
          ]
        },
        {
          "id": "limitConfig",
          "label": "Album Feed Limit",
          "description": "Maximum number of home albums to scrape and parse simultaneously.",
          "icon": "list-ol",
          "elements": [
            {
              "type": "input",
              "id": "albumLimitInput",
              "inputType": "number",
              "variable": "albumLimit",
              "min": 4,
              "max": 30,
              "step": 2,
              "default": 12
            },
            {
              "type": "button",
              "id": "saveLimitBtn",
              "label": "Apply Limit",
              "accent": "mauve",
              "execute": "updateScraperSettings(albumLimit)"
            }
          ]
        }
      ]
    }
  ]
}