{
  "imports": "./Dsettings.js",
  "sections": [
    {
      "id"     : "discord",
      "label"  : "Discord Media Integration",
      "icon"   : "brands fa-discord",
      "accent" : "mauve",
      "entries": [
        {
          "id"         : "discordAuth",
          "label"      : "Authentication",
          "description": "Select the token type and save your Discord token",
          "icon"       : "key",
          "accent"     : "mauve",
          "elements"   : [
            {
              "type"    : "dropdown",
              "id"      : "discordTokenType",
              "variable": "discordTokenType",
              "default" : "Bot",
              "options" : [
                { "value": "Bot",  "label": "Bot Token (Safe)"  },
                { "value": "User", "label": "User Token (Nuuh)" }
              ]
            },
            {
              "type"       : "input",
              "id"         : "discordTokenInput",
              "inputType"  : "password",
              "variable"   : "discordToken",
              "placeholder": "Paste Token Here",
              "default"    : ""
            },
            {
              "type"   : "button",
              "id"     : "discordVerifyBtn",
              "label"  : "Save Token",
              "accent" : "green",
              "execute": "discord_saveToken(discordTokenType, discordToken)"
            }
          ]
        },
        {
          "id"         : "discordServers",
          "label"      : "Manage Servers",
          "description": "Add Server IDs to fetch media from.",
          "icon"       : "server",
          "accent"     : "blue",
          "elements"   : [
            {
              "type"       : "input",
              "id"         : "discordServerInput",
              "variable"   : "discordNewServer",
              "placeholder": "Server ID",
              "default"    : ""
            },
            {
              "type"   : "button",
              "id"     : "discordAddServerBtn",
              "label"  : "Add",
              "accent" : "blue",
              "execute": "discord_addServer(discordNewServer)"
            },
            {
              "type": "dropdown",
              "id"  : "discordServerList"
            },
            {
              "type"   : "button",
              "id"     : "discordRemoveServerBtn",
              "label"  : "Remove",
              "accent" : "red",
              "execute": "discord_removeServer()"
            }
          ]
        },
        {
          "id"         : "discordChannels",
          "label"      : "Channel Filters",
          "description": "Blacklist (hide) or Whitelist (only show) channels bt ID",
          "icon"       : "filter",
          "accent"     : "yellow",
          "elements"   : [
            {
              "type"    : "toggle",
              "id"      : "discordFilterToggle",
              "variable": "discordIsWhitelist",
              "default" : false,
              "execute" : "discord_toggleFilterMode(discordIsWhitelist)"
            },
            {
              "type"       : "input",
              "id"         : "discordChannelInput",
              "variable"   : "discordNewChannel",
              "placeholder": "Channel ID",
              "default"    : ""
            },
            {
              "type"   : "button",
              "id"     : "discordAddChannelBtn",
              "label"  : "Add",
              "accent" : "yellow",
              "execute": "discord_addChannel(discordNewChannel)"
            },
            {
              "type": "dropdown",
              "id"  : "discordChannelList"
            },
            {
              "type"   : "button",
              "id"     : "discordRemoveChannelBtn",
              "label"  : "Remove",
              "accent" : "red",
              "execute": "discord_removeChannel()"
            }
          ]
        },
        {
          "id"         : "discordAction",
          "label"      : "Fetch Content",
          "description": "Scan servers and fill Folders view with channel media folders",
          "icon"       : "cloud-arrow-down",
          "accent"     : "green",
          "elements"   : [
            {
              "type"   : "button",
              "id"     : "discordLoadBtn",
              "label"  : "Load Channels",
              "accent" : "mauve",
              "execute": "discord_loadFolders()"
            }
          ]
        }
      ]
    }
  ]
}